[
  { "name": "zero", "args": [0], "expected": "0B" },
  { "name": "bytes", "args": [12], "expected": "12B" },
  { "name": "unit boundary", "args": [1024], "expected": "1KB" },
  { "name": "fractional kibibytes", "args": [1536], "expected": "1.5KB" },
  { "name": "megabytes", "args": [1048576], "expected": "1MB" },
  { "name": "negative", "args": [-1024], "expected": "-1KB" },
