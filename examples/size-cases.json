  { "name": "unit separator", "args": [1024, { "unitSeparator": " " }], "expected": "1 KB" },
  { "name": "forced unit", "args": [1048576, { "unit": "KB" }], "expected": "1024KB" },
  { "name": "invalid string", "args": ["1024"], "expectedError": { "name": "TypeError", "message": "size must be a finite number" } },
