{
  "name": "carve-local-prototype",
  "version": "0.38.1",
  "private": true,
  "description": "REA companion MCP for agents: evidence-linked feature choices, bounded extraction, behavior checks and reusable local functions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "bin": {
    "carve": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    "CHANGELOG.md",
    "MILESTONE.md",
    "engines",
    "DEVELOPMENT.md",
    "docs",
    "examples/native-app",
    "examples/android",
    "examples/jvm",
    "examples/project-plan.json",
    "examples/work-plan.json",
    "examples/work-spec.json",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "verify:install": "npm run build && node scripts/verify-install.mjs",
    "verify:rea": "npm run build && node scripts/verify-rea.mjs",
    "verify:public": "npm run build && node scripts/verify-public.mjs",
    "prepack": "npm run build",
    "check": "node scripts/check-release.mjs",
    "verify:native": "npm run build && node scripts/verify-native.mjs",
    "verify:scale": "npm run build && node scripts/verify-scale.mjs",
    "verify:android": "npm run build && node scripts/verify-android.mjs",
    "verify:android-protocol": "npm run build && node scripts/verify-android-protocol.mjs",
    "verify:jq": "npm run build && node scripts/verify-jq.mjs",
    "verify:queue": "npm run build && node scripts/verify-analysis-queue.mjs",
    "verify:background": "npm run build && node scripts/verify-analysis-background.mjs",
    "verify:multi": "npm run build && node scripts/verify-multi-artifact.mjs",
    "verify:links": "npm run build && node scripts/verify-links.mjs",
    "verify:loader": "npm run build && node scripts/verify-loader.mjs",
    "verify:openssl": "npm run build && node scripts/verify-openssl.mjs",
    "verify:apk-manifest": "npm run build && node scripts/verify-apk-manifest.mjs",
    "verify:zxing-vcard": "npm run build && node scripts/verify-zxing-vcard.mjs",
    "benchmark:verification": "npm run build && node scripts/benchmark-verification.mjs",
    "verify:engine-resources": "npm run build && node scripts/verify-engine-resources.mjs",
    "verify:jni": "npm run build && node scripts/verify-jni.mjs",
    "verify:jni-adler32": "npm run build && node scripts/verify-jni-adler32.mjs",
    "android:emulator": "node scripts/android-emulator.mjs",
    "verify:termux-bootstrap": "npm run build && node scripts/verify-termux-bootstrap.mjs",
    "verify:rea-native": "npm run build && node scripts/verify-rea-native.mjs",
    "verify:rea-relationships": "npm run build && node scripts/verify-rea-relationships.mjs",
    "verify:rea-bridge": "npm run build && node scripts/verify-rea-bridge.mjs",
    "verify:rea-stateful": "npm run build && node scripts/verify-rea-stateful.mjs",
    "verify:rea-adler32-stateful": "npm run build && node scripts/verify-rea-adler32-stateful.mjs",
    "verify:zxing-stateful": "npm run build && node scripts/verify-zxing-stateful.mjs",
    "verify:rea-bridge-cross-workspace": "npm run build && node scripts/verify-rea-bridge.mjs --cross-workspace",
    "verify:feature-scope": "npm run build && node scripts/verify-feature-scope.mjs",
    "verify:project-intent": "npm run build && node scripts/verify-project-intent.mjs",
    "verify:work-package": "npm run build && node scripts/verify-work-package.mjs",
    "verify:work-ledger": "npm run build && node scripts/verify-work-ledger.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@electron/asar": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^14.0.0",
    "esbuild": "^0.25.0",
    "yauzl": "3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@sindresorhus/slugify": "3.0.1",
    "@types/node": "^24.0.0",
    "@types/yauzl": "3.4.0",
    "bytes": "3.1.2",
    "camelcase": "10.0.0",
    "change-case": "5.4.4",
    "fast-json-stable-stringify": "2.1.0",
    "ms": "2.1.3",
    "pretty-bytes": "7.2.0",
    "typescript": "^5.9.0"
  }
}
